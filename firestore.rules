rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        // Custom claims no token do Firebase Auth
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        // Flags salvas no documento do usuário
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          )
        )
      );
    }

    // Billing and authorization fields are server-managed.
    function hasSafeInitialAccountState() {
      return request.resource.data.get('credits', 0) == 0 &&
        request.resource.data.get('totalCreditsEarned', 0) == 0 &&
        request.resource.data.get('isPremium', false) == false &&
        request.resource.data.get('isAdmin', false) == false &&
        request.resource.data.get('role', 'user') == 'user' &&
        !request.resource.data.keys().hasAny([
          'stripeCustomerId',
          'subscriptionId',
          'subscriptionStatus',
          'subscriptionEndDate',
          'planType',
          'planTier',
          'lastPurchaseAt',
          'lastPackageId'
        ]);
    }

    function onlyUpdatesEditableProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'displayName',
        'fullName',
        'photoURL',
        'lastLoginAt',
        'updatedAt',
        'hasCompletedQuestionnaire',
        'age',
        'nationality',
        'occupation',
        'immigrationGoal',
        'questionnaireCompletedAt',
        'selectedVisaPath',
        'recommendedVisa',
        'selectedVisa',
        'completedQuiz',
        'quizAnswers',
        'quizScores'
      ]);
    }

    function isLeadOwnerByEmail() {
      return isAuthenticated() &&
        resource != null &&
        resource.data.email == request.auth.token.email;
    }

    // Fluxo público do teste gratuito:
    // permite apenas transição de status "lead" -> "quiz_completed"
    // mantendo campos-base do lead imutáveis.
    function isPublicQuizCompletionUpdate() {
      return resource != null &&
        resource.data.source == 'teste-gratuito' &&
        resource.data.status == 'lead' &&
        request.resource.data.status == 'quiz_completed' &&
        request.resource.data.source == resource.data.source &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.fullName == resource.data.fullName &&
        request.resource.data.whatsapp == resource.data.whatsapp &&
        request.resource.data.age == resource.data.age &&
        request.resource.data.timeframe == resource.data.timeframe &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'education',
          'fieldOfStudy',
          'occupation',
          'yearsOfExperience',
          'englishLevel',
          'immigrationGoal',
          'savings',
          'hasJobOffer',
          'hasFamily',
          'topVisa',
          'topVisaScore',
          'secondVisa',
          'secondVisaScore',
          'thirdVisa',
          'thirdVisaScore',
          'profileSummary',
          'status',
          'completedAt'
        ]);
    }

    function isValidPublicLead() {
      return request.resource.data.keys().hasOnly([
          'fullName', 'email', 'whatsapp', 'age', 'timeframe',
          'source', 'status', 'createdAt'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 150 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.whatsapp is string &&
        request.resource.data.whatsapp.size() <= 30 &&
        request.resource.data.age is int &&
        request.resource.data.age >= 16 &&
        request.resource.data.age <= 100 &&
        request.resource.data.timeframe is string &&
        request.resource.data.timeframe.size() <= 100 &&
        request.resource.data.source == 'teste-gratuito' &&
        request.resource.data.status == 'lead' &&
        request.resource.data.createdAt == request.time;
    }

    // ============================================================
    // Users collection
    // ID do documento = UID do usuário
    // ============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        hasSafeInitialAccountState();
      allow update: if (isOwner(userId) && onlyUpdatesEditableProfileFields()) || isAdmin();
      allow delete: if isAdmin();

      // Subcoleção de histórico de créditos
      // Leitura: o próprio usuário ou admin
      // Escrita: somente Admin SDK/backend ou admin autenticado
      match /creditHistory/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin();
        allow update: if false; // transacões são imutáveis
        allow delete: if isAdmin();
      }
    }

    // ============================================================
    // Questionnaires collection
    // ID do documento = UID do usuário
    // ============================================================
    match /questionnaires/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // Analysis results collection
    // Suporta tanto setDoc(userId) quanto addDoc(ID automático)
    // ============================================================
    match /analysisResults/{docId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == docId ||
        (resource != null && resource.data.userId == request.auth.uid)
      ) || isAdmin();
      // Cliente pode criar (necessário para addDoc e setDoc do web)
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // Update continua fechado no cliente; delete permitido para admin
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ============================================================
    // Visa paths collection
    // ID do documento = UID do usuário
    // ============================================================
    match /visaPaths/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // Training sessions collection (uso do Web - treinamento com IA)
    // Coleção: training_sessions (com underscore)
    // ============================================================
    match /training_sessions/{sessionId} {
      // Query por userId: permite se o usuário é o dono
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid
      ) || isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid || isAdmin();
    }

    // ============================================================
    // Training stats collection (uso do Web)
    // ID do documento = UID do usuário
    // ============================================================
    match /training_stats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // Subscriptions collection (Stripe - uso do Web)
    // ============================================================
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid || isAdmin();
      // Somente Cloud Functions/webhook do Stripe escrevem
      allow write: if false;
    }

    // ============================================================
    // Payment intents collection (Stripe - uso do Web)
    // ============================================================
    match /paymentIntents/{paymentId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid || isAdmin();
      // Somente Cloud Functions escrevem
      allow write: if false;
    }

    // ============================================================
    // Detailed reports collection
    // ============================================================
    match /detailedReports/{reportId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid || isAdmin();
      allow write: if false;
    }

    // ============================================================
    // DS-160 helper data (uso do Web)
    // ============================================================
    match /ds160/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // Chat sessions (uso do Web - chat com IA)
    // ============================================================
    match /chatSessions/{sessionId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid || isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource != null &&
        resource.data.userId == request.auth.uid || isAdmin();
    }

    // ============================================================
    // Leads collection (captura de leads do teste-gratuito.tsx)
    // Qualquer pessoa pode criar (não requer login)
    // Atualização pública permitida apenas para concluir quiz do próprio lead
    // ============================================================
    match /leads/{leadId} {
      allow create: if isValidPublicLead();
      allow read: if isLeadOwnerByEmail() || isAdmin();
      allow update: if isLeadOwnerByEmail() || isAdmin() || isPublicQuizCompletionUpdate();
      allow delete: if isAdmin();
    }

    // ============================================================
    // Admin super access (fallback)
    // Garante que contas admin consigam auditar e gerenciar qualquer
    // coleção necessária no painel administrativo.
    // ============================================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}
